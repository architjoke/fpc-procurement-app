    "express": "^4.21.1",
    "express-rate-limit": "^7.5.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "uuid": "^11.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.1",
    "@types/cors": "^2.8.5",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/multer": "^1.4.5",
    "@types/node": "^22.10.1",
    "@types/supertest": "^6.0.0",
    "prisma": "^5.16.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
